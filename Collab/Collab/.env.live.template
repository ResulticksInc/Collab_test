# ----- Mobile push (Collab_mobile Flutter app: Android + iOS) -----
# Every web push is mirrored to the user's registered phones as an FCM message.
# REQUIRED for phones to receive anything: a Firebase SERVICE ACCOUNT key for
# project collab-7531d (the project in the app's google-services.json).
#   Firebase console > Project settings > Service accounts > Generate new private key
#   Save it on EVERY backend host — UAT *and* production (run) — as
#   ./keys/fcm-service-account.json (chmod 600). It is gitignored (keys/*.json),
#   so it is NOT in the deploy bundle: copy it by hand on each host. Without it the
#   backend boots fine and iOS calls still ring (APNs VoIP), but every message /
#   mention / meeting push to phones is dropped — "only call notifications work".
#   Verify: GET /api/health/ready → checks.push.configured.fcm must be true.
FCM_SERVICE_ACCOUNT_FILE=/app/keys/fcm-service-account.json
# Alternative to the file: the same JSON inline, base64 encoded
#   base64 -i fcm-service-account.json | tr -d '\n'
# FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=collab-7531d
# How long FCM holds a message for an offline phone (seconds).
FCM_MESSAGE_TTL_SEC=86400
FCM_CALL_TTL_SEC=45

# APNs VoIP (iOS incoming calls ring via CallKit even when the app is closed).
# "Collab APNs Key" (Sandbox & Production, all topics). Same key is uploaded to
# Firebase collab-7531d. ./keys is mounted at /app/keys, so the path is in-container.
# NOTE: this .p8 IS tracked in git, so it ships in the bundle — which is why calls
# can ring on a host where the (untracked) FCM file above is missing.
APNS_KEY_ID=37PG75SL4U
APNS_TEAM_ID=9G6WTL8BCF
APNS_KEY_FILE=/app/keys/AuthKey_37PG75SL4U.p8
APNS_BUNDLE_ID=com.resulticks.collab
# sandbox for Xcode/dev-profile builds, production for TestFlight/App Store
# (Backend-Push-Configuration-UAT-and-Production.md, Step 5).
APNS_ENVIRONMENT=${APNS_ENVIRONMENT}
