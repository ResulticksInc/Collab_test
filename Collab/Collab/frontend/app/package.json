{
  "name": "@colab/frontend",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 ../../node_modules/next/dist/bin/next dev -p 3002 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000",
    "cf:build": "cross-env CF_STATIC=1 NEXT_PUBLIC_WS_FIRST=1 NEXT_PUBLIC_API_BASE_URL= NEXT_PUBLIC_SOCKET_URL= next build",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:preview": "npm run cf:build && wrangler dev",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
