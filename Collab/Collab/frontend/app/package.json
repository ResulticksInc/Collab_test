    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "dompurify": "^3.4.10",
    "gifenc": "^1.0.3",
    "gsap": "^3.15.0",
    "livekit-client": "^2.19.1",
    "lowlight": "^3.3.0",
    "next": "^14.2.5",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
