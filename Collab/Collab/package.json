{
  "name": "colab",
  "private": true,
  "version": "1.0.1",
  "description": "CoLab V1 — enterprise collaboration platform (monorepo).",
  "workspaces": [
    "config",
    "shared",
    "database",
    "backend",
    "frontend/app",
    "mcp",
    "agents",
    "desktop"
  ],
  "scripts": {
    "predev": "node scripts/predev.cjs",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:json": "cross-env DATABASE_DRIVER=json concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:local": "node -e \"require('fs').copyFileSync('.env.local','.env')\" && node scripts/free-port.cjs 3002 && docker compose up -d --wait && npm run dev:web",
    "dev:server": "node -e \"require('fs').copyFileSync('.env.server','.env')\" && npm run dev",
    "dev:backend": "tsx watch backend/app/src/index.ts",
    "dev:frontend": "npm --workspace frontend/app run dev",
    "dev:demo": "node scripts/dev-demo.cjs",
    "dev:web":"cross-env NEXT_PUBLIC_API_BASE_URL= NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:4000 BACKEND_INTERNAL_URL=http://127.0.0.1:4000 LIVEKIT_INTERNAL_URL=http://127.0.0.1:7534 npm --workspace frontend/app run dev",
    "dev:desktop": "npm --workspace @collab/desktop run dev",
    "build:desktop": "npm run build && npm --workspace @collab/desktop run build",
    "db:migrate": "tsx database/src/migrate.ts",
    "db:seed": "tsx database/src/seed.ts",
    "db:prepare:release": "tsx database/src/prepare-release-dbs.ts",
    "start": "tsx backend/app/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:arch": "depcruise \"config/**/*.{ts,tsx,js,jsx}\" \"shared/**/*.{ts,tsx,js,jsx}\" \"database/**/*.{ts,tsx,js,jsx}\" \"backend/**/*.{ts,tsx,js,jsx}\" \"frontend/app/src/**/*.{ts,tsx,js,jsx}\" \"mcp/**/*.{ts,tsx,js,jsx}\" \"agents/**/*.{ts,tsx,js,jsx}\" --output-type err --config .dependency-cruiser.cjs",
    "lint:circular": "madge --circular --extensions ts,tsx,js,jsx config shared database backend frontend/app/src mcp agents",
    "lint:orphans": "madge --orphans --extensions ts,tsx,js,jsx config shared database backend frontend/app/src mcp agents",
    "lint:dead": "knip",
    "lint:deps": "depcheck ./backend && depcheck ./frontend/app --ignores=@types/node,@types/react && depcheck ./database --ignores=mysql2 && depcheck ./shared && depcheck ./config",
    "typecheck": "npm run typecheck:fe && npm run typecheck:be",
    "build": "npm --workspace frontend/app run build",
    "test": "npm --workspace frontend/app run test --if-present",
    "test:e2e": "playwright test",
    "a11y": "playwright test accessibility",
    "security": "audit-ci --high --config audit-ci.json",
    "secrets": "secretlint \"**/*\"",
    "validate": "npm run lint:arch && npm run lint:circular && npm run lint:orphans && npm run lint:dead && npm run lint:deps",
    "truth": "npm run format:check && npm run validate && npm run typecheck && npm run test:unit && npm run build && npm run test && npm run test:e2e && npm run a11y && npm run security && npm run secrets",
    "gate": "npm run truth",
    "chromatic": "chromatic --exit-zero-on-changes",
    "analyze": "cross-env ANALYZE=true npm --workspace frontend/app run build",
    "scan": "echo \"Run against dev server: npx react-scan@latest http://localhost:3000\"",
    "typecheck:fe": "npm --workspace frontend/app run typecheck --if-present",
    "typecheck:be": "tsc -p tsconfig.json --noEmit",
    "pretest:unit": "node --import tsx backend/app/test/_migrate-testdb.ts",
    "test:unit": "node --import tsx --test --test-force-exit backend/app/test/*.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^14.2.5",
    "@playwright/test": "^1.48.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.4",
    "audit-ci": "^7.1.0",
    "chromatic": "^11.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^10.4.1",
    "knip": "^5.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "secretlint": "^13.0.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "axios": "^1.17.0",
    "form-data": "^4.0.5",
    "socket.io-client": "^4.8.3"
  }
}
