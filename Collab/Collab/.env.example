# ================= CoLab environment =================
# Copy to .env. Only config/ reads these — never application modules.

NODE_ENV=development

# ----- Demo mode: the ONE switch (yes / no) -----
# yes -> seeded sample workspace (team + conversations + messages + tasks…) for showcase/demos.
# no  -> LIVE: real backend + persistence. The team directory is seeded so you can test
#        collaboration, but the workspace starts EMPTY — you create chats/tasks/etc. and they
#        persist. Logging in with a new email creates a real account.
DEMO_MODE=no

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
# Loopback + private-LAN origins (10.x/192.168.x/172.16-31.x) are auto-allowed on
# any port, so a test server like http://10.205.11.8:3002 works without listing it.
CORS_ORIGINS=http://localhost:3002

# ----- Auth -----
AUTH_JWT_SECRET=dev-only-change-me
AUTH_TOKEN_TTL=7d
# Public self-service sign-up. OFF by default: accounts are provisioned by an admin
# (org admin console → provision user) or auto-created on first SSO login. The
# frontend hides the Sign-Up UI when NEXT_PUBLIC_FEATURE_SIGNUP=0; THIS flag is the
# server-side enforcement (POST /api/auth/signup returns 403 when false). Set both
# to enable self-registration.
AUTH_SIGNUP_ENABLED=false
# Multi-factor auth (TOTP authenticator apps + one-time backup codes). OFF by
# default: enrollment is dormant and login is unchanged. Set MFA_ENABLED=true to
# let users enrol a second factor (Settings → Security); enrolled users are then
# prompted for a code at sign-in. The TOTP seed is sealed with a key derived from
# AUTH_JWT_SECRET, so no extra secret is needed.
MFA_ENABLED=false

# ----- Collab Admin Panel (/admin) -----
# Dedicated administrative credentials for the Collab Admin Panel.
# Set a strong password in production.
ADMIN_EMAIL=admin@collab.local
ADMIN_PASSWORD=admin1234
ADMIN_SESSION_TTL=12h

# ----- Chat media (GIF/sticker search) -----
# GIF/sticker SEARCH is powered by GIPHY (Tenor was sunset by Google 2026-06-30).
# OPTIONAL — leave blank and members still get the built-in sticker pack + the
# create-your-own studio; a tenant admin can also set a per-org key in the admin
# console (Org → Settings → GIF search). Set this for a deployment-wide default.
# Get a free key at https://developers.giphy.com (note: free/beta keys are rate-limited).
GIPHY_API_KEY=

# ----- Database -----
# For local dev (bare-metal backend via `npm run dev:local`): localhost reaches the
# published Docker port of the `db` container.
# Postgres (Supabase in production, the compose `db` container locally). The URL
# scheme selects the driver: postgres:// → database/src/drivers/postgres.ts.
# Supabase: use the Supavisor pooler URL from the dashboard (port 6543, transaction
# mode) and set DB_SSL=require:
#   DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://colab:colab@localhost:5432/colab
# DB_SSL=require
# For `docker compose up` (full Docker stack): the backend container must use the
# Docker-internal service name `db`, not localhost. These _DOCKER vars override only
# inside the container; leave them blank for the default db:5432.
# DATABASE_URL_DOCKER=postgres://colab:colab@db:5432/colab
# DEMO_DATABASE_URL_DOCKER=postgres://colab:colab@db:5432/colab_demo

# ----- Frontend (exposed to the browser; must be NEXT_PUBLIC_*) -----
# Leave BLANK for same-origin: the Next server reverse-proxies /api and
# /socket.io to the backend (next.config.js rewrites), so the app works on any
# host/port/device with no CORS and no per-host rebuild. Only set these if the
# API is on a separate origin with no proxy in front.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SOCKET_URL=
# Backend address for the proxy (server-side only; default http://localhost:4000).
# Set to e.g. http://backend:4000 in Docker, or the backend host elsewhere.
# BACKEND_INTERNAL_URL=http://localhost:4000
# Who you log in as. Change this (and restart) to test as a different teammate in live mode,
# e.g. emily@colab.app, marcus@colab.app, priya@colab.app, david@colab.app, lena@colab.app.
NEXT_PUBLIC_USER_EMAIL=you@colab.app
NEXT_PUBLIC_APP_NAME=Collab
NEXT_PUBLIC_WORKSPACE_NAME=Collab
# NEXT_PUBLIC_* are baked into the frontend at BUILD time — rebuild after changing.
NEXT_PUBLIC_FEATURE_SIGNUP=0
# E2EE ENABLED — same-device seamless + new-device history sync (Mechanism A) +
# progressive-rollout fallback (B1/B2), audited data-safe (additive, no wipe).
# The code default is still off, so the flag must equal "true". Both the frontend
# (NEXT_PUBLIC_E2EE_ENABLED) and backend (E2EE_ENABLED) masters must be on.
# Reversible — flip to false → encrypted msgs dormant, never lost. See
# docs/E2EE_LIVE_ROLLOUT.md. For a STAGED prod rollout: backup → pilot → expand.
NEXT_PUBLIC_E2EE_ENABLED=true
NEXT_PUBLIC_E2EE_DECRYPT_LEGACY=true
E2EE_ENABLED=true
# Double Ratchet (post-compromise security) — only applies to DM text payloads
# when E2EE is enabled. Files/groups/calls use ECIES/shared-epoch.
NEXT_PUBLIC_E2EE_RATCHET=false
# B2 strict mode (sender signature required). Default OFF for the migration
# window so pre-B2 enrolled devices (no published signing key yet) can still be
# read. Flip to "true" AFTER all clients have re-initialized at least once and
# republished their signing key — then any unsigned envelope is rejected as
# forged. Has no effect when NEXT_PUBLIC_E2EE_ENABLED=false.
NEXT_PUBLIC_E2EE_REQUIRE_SIGNATURES=false
# GAP-3: device-bound JWT STRICT mode (backend). When ON, a request whose token
# has no deviceId (or whose deviceId is revoked/unknown) is rejected with 401.
# Default OFF (permissive) so existing tokens minted before the deviceId claim
# are not locked out. Flip to "true" only AFTER one full AUTH_TOKEN_TTL window
# (typically 7-14d) has elapsed so all active tokens have re-rotated. Once
# strict, a revoked device cannot retain API/metadata access.
E2EE_DEVICE_BOUND_JWT_STRICT=false
# AUTOMATIC history recovery (docs/E2EE_AUTO_RECOVERY.md). The server keeps one
# sealed ACCOUNT KEY per user and serves it to that user's signed-in sessions;
# the client wraps the backup secret under it so a new device, SSO login,
# restored session or reinstall shows full history with NO password prompt.
# Trade-off: an operator with the DB + E2EE_ESCROW_SECRET can open history
# BACKUPS (live messages stay E2EE). Set false for the strictly server-blind
# model (restores then need a typed credential).
E2EE_AUTO_RECOVERY=true
# Secret the account keys are sealed under. Falls back to AUTH_JWT_SECRET when
# empty; set a dedicated long random value in production.
E2EE_ESCROW_SECRET=

# ----- LiveKit media -----
# LIVEKIT_WS_URL is sent to browsers inside the room token; set it to the
# server's reachable IP/hostname when deploying outside localhost.
# Must also match node_ip in infrastructure/livekit/livekit.server.yaml.
# Example (behind nginx + TLS): # ── Meeting chat policy (§11 open questions) ────────────────────────────────
# MCHAT-21: what an UNINVITED link-joiner sees of the meeting chat's history.
#   joinpoint (default) = messages from their join forward (the PRD's stated
#                         requirement, pending legal validation)
#   full                = the whole thread
MEETING_LINK_JOINER_HISTORY=joinpoint
# REC-05: when set, recording consent notices cite this workspace policy URL.
NEXT_PUBLIC_RECORDING_POLICY_URL=

LIVEKIT_WS_URL=wss://YOUR_SERVER_HOST/livekit
LIVEKIT_WS_URL=ws://localhost:7534
# Backend/internal URL for server SDK calls — this is NOT the browser-facing URL.
#
# When the backend runs in Docker (the default compose setup) this MUST be
# ws://livekit:7534. "localhost" inside the backend container means the CONTAINER,
# not the host, so the LiveKit admin API is unreachable — and because every admin
# call is fail-soft, the symptom is silent: "Mute everyone", per-participant mute,
# remove-participant and End-for-everyone all report success while doing nothing.
# Only set this to localhost when the backend runs directly on the host (not in
# compose). LIVEKIT_WS_URL above is the browser-facing one and stays localhost.
LIVEKIT_SERVER_URL=ws://livekit:7534
LIVEKIT_API_KEY=colab-prod
LIVEKIT_API_SECRET=change-me-to-a-long-random-livekit-secret
LIVEKIT_TOKEN_TTL_SEC=3600
# Meeting recording (LiveKit Egress). Requires the separate egress worker:
#   docker compose --profile recording up -d egress
# then set EGRESS_ENABLED=yes. Until then, recording returns an honest 503.
# (livekit.yaml already declares the redis bus + completion webhook for it.)
EGRESS_ENABLED=no

# ----- File storage (local disk first, Cloudflare R2 every 2 h) -----
# Attachments are written to the local disk tier and copied to the encrypted R2
# archive below by the backend job; MinIO and the database blob tier were
# removed on 2026-10-22. "disk" is the only accepted tier.
FILE_STORAGE_ORDER=disk
# Root of the disk tier. Containers: /app/data/files (named volume files_data).
FILE_STORAGE_DIR=./data/files
# Disk tier refuses an upload (honest 503) unless this much stays free.
FILE_STORAGE_MIN_FREE_BYTES=536870912

# ----- Encrypted R2 archive of messages + attachments (docs/R2_ARCHIVE_SYNC.md) -----
# Chat messages and attachments are stored locally first (MySQL / disk tier) and a
# backend job copies them to Cloudflare R2 every R2_ARCHIVE_INTERVAL_MINUTES,
# encrypted (AES-256-GCM, per-object data key wrapped by the keyring below),
# verified, and only then marked archived. Attachments drop their local bytes
# after verification when R2_ARCHIVE_PRUNE_LOCAL_FILES=true. ON by default (the
# job idles with a logged config error until the R2_* credentials are filled in).
R2_ARCHIVE_ENABLED=true
# S3 API endpoint of the R2 account (the bucket may be given as the path).
R2_ENDPOINT=https://69edcef1c210683e0bbb1d4d9de4bbcc.r2.cloudflarestorage.com
R2_BUCKET=collab
# R2 API token with Object Read & Write on the bucket. BACKEND-ONLY — never in
# any NEXT_PUBLIC_* var or frontend code.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keyring "kid:base64(32 bytes)[,kid2:…]" + the kid that encrypts NEW objects.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes the archive unreadable — keep it in your secrets manager.
R2_ARCHIVE_KEYS=
R2_ARCHIVE_ACTIVE_KEY=k1
R2_ARCHIVE_INTERVAL_MINUTES=120
R2_ARCHIVE_MIN_AGE_MINUTES=10
R2_ARCHIVE_PRUNE_LOCAL_FILES=true
# R2_ARCHIVE_PREFIX=colab

# ----- API debug log -----
# console.log EVERY API request (method, path, query, payload) and response (status,
# time, body) — secrets redacted, bodies truncated (API_DEBUG_LOG_MAX, default 4000).
# For integration debugging (mobile app ↔ dev backend). NEVER in production.
API_DEBUG_LOG=false
# API_DEBUG_LOG_HEALTH=false   # include /api/health polling (noisy)

# ----- SSO (OpenID Connect — Authorization Code + PKCE) -----
# One shared IdP for all teams: KEEP the idp/authorize/scope lines. Register THIS
# app on the IdP to get a client_id (+ optional secret). Token & JWKS endpoints
# are auto-discovered/derived from the issuer. Full guide: docs/SSO.md.
SSO_ENABLED=true
# IdP BASE URL (AgenXchange staging). Authorize/token/jwks/logout are derived from
# it (<base>/authorize, /token, /jwks, /logout) unless set explicitly below.
SSO_BASE_URL=https://stgoa.re.cx/
# Blank → the browser goes STRAIGHT to the authorize URL. This IdP's /login path
# serves its marketing homepage (not a login form), so the /login?return_to= wrapper
# is OFF. Set this to the IdP host only if your IdP actually needs that wrapper.
SSO_IDP_URL=
SSO_AUTHORIZE_URL=https://stgoa.re.cx/authorize
SSO_SCOPE=openid profile email
SSO_CLIENT_ID=collab                                 # «replace» your registered client
SSO_CLIENT_SECRET=                                   # REQUIRED for stgoa.re.cx: `collab` is a confidential client (blank → /token 401 invalid_client)
# Extra client ids whose id_tokens are ACCEPTED (aud) — the mobile app's own IdP
# registration when it does the OIDC exchange natively and POSTs /api/auth/sso/token.
SSO_EXTRA_CLIENT_IDS=
SSO_REDIRECT_URI=http://localhost:3002               # app ROOT; must match IdP EXACTLY (no trailing slash)
# Back-channel PINNED to the public host. Discovery may advertise an INTERNAL IdP
# address the backend cannot reach; stgoa.re.cx fronts these over HTTPS. ISSUER is
# whatever the IdP stamps in the id_token `iss` — staging discovery publishes
# https://stgoa.re.cx (the old IdP stamped its internal http://10.200.1.58:7505).
# The base URL's origin is ALSO accepted, and a mismatch is reported verbatim at login.
SSO_TOKEN_URL=https://stgoa.re.cx/token
SSO_JWKS_URL=https://stgoa.re.cx/jwks
SSO_ISSUER=https://stgoa.re.cx
# ENCRYPTED PII (claims_jwe). The IdP encrypts email/department/employee_id/picture
# to OUR public key (keys/agenxchange_public.pem — give it to AgenXchange). The
# private half decrypts here: a file path, or the PEM inline (raw or base64) for
# secret stores. Generate both with scripts/gen-sso-keys.sh. REQUIRED once the IdP
# starts sending claims_jwe — without it those logins are rejected (fail closed).
SSO_JWE_PRIVATE_KEY_FILE=keys/collab_private.pem
SSO_JWE_PRIVATE_KEY=
# FERNET profile copies (guide v3 *_enc: email_enc, name_enc, picture_enc, …). The
# SSO team's shared secret (key = base64url(SHA256(secret))). Server-side only.
# Needed until CoLab's public key is registered for claims_jwe, or while the IdP
# sends *_enc only. Blank = *_enc fields ignored.
SSO_PROFILE_ENC_SECRET=
# SSO_INSECURE_SKIP_VERIFY=false                     # DEV ONLY: skip id_token sig check
NEXT_PUBLIC_SSO_ENABLED=true

# ----- Meeting end warnings -----
# Notify everyone IN a meeting that it is about to end. Comma-separated minutes
# before the scheduled end, largest first. Default 10,5. Empty disables it.
# A lead longer than the meeting itself is skipped (a 10-minute warning on a
# 10-minute meeting would fire at the start, which isn't a warning).
MEETING_END_WARNING_MINUTES=10,5

# ----- Chat webhooks (incoming + outgoing) -----
# Slack-style INCOMING webhooks post an external system's JSON into one DM or
# group; OUTGOING subscriptions POST every chat event to your URL, HMAC-signed.
# See docs/CHAT_WEBHOOKS.md. On by default; set false to make the whole feature
# dormant (the ingest endpoint 404s and no outbound call is ever made).
WEBHOOKS_ENABLED=true
# Per-conversation cap, so one member can't turn a busy group into an amplifier.
WEBHOOKS_MAX_PER_CONVERSATION=10
# Per-delivery HTTP timeout, and attempts before a delivery is permanently failed
# (exponential backoff: ~30s, 2m, 8m, 32m).
WEBHOOKS_TIMEOUT_MS=8000
WEBHOOKS_MAX_ATTEMPTS=5
# Messages accepted per INCOMING webhook per minute, and the per-IP ceiling on
# the ingest endpoint (which is unauthenticated by design — the token is the
# credential).
WEBHOOKS_INGEST_PER_MINUTE=60
WEBHOOKS_INGEST_IP_RATE_MAX=120
# How often the delivery queue is drained, and how long the delivery log (which
# embeds message text) is retained.
WEBHOOKS_DRAIN_SECONDS=20
WEBHOOKS_DELIVERY_RETENTION_DAYS=30
# SSRF: outgoing targets are DNS-resolved and private/loopback/link-local
# addresses are REFUSED, on every attempt. Only turn this on for an on-prem
# deployment whose integration endpoints genuinely live on the internal network
# — it lets any member point a webhook at an internal address.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false
# Absolute base URL used to render the copy-paste ingest URL. Falls back to a
# relative path when unset.
# PUBLIC_API_URL=https://colab.example.com

# ----- External Data API (/api/external/v1) -----
# API other platforms (CRM, BI, reporting, partners) use to READ this
# deployment's MySQL data — users, conversations, messages, meetings, tasks,
# files and an allow-listed generic table reader — and to ACT in CoLab as a user
# (send/receive messages, calls, meetings), with an API KEY instead of a
# person's session. Keys are minted by an org admin (POST /api/orgs/current/api-keys)
# or the admin portal (POST /api/admin/api-keys) and stored hashed.
# See docs/EXTERNAL_DATA_API.html. On by default; false makes every route 404.
EXTERNAL_API_ENABLED=true
# STATIC platform keys (comma-separated), so a fresh deployment can call the API
# before anyone has minted a key. Full read + write access to EVERY organization —
# treat like a root password. Format: "colab_" + 32 url-safe random characters.
# The value below is a PLACEHOLDER — generate a real one per environment with:
#   node -e 'console.log("colab_"+require("crypto").randomBytes(24).toString("base64url"))'
# A static key has no default actor: write calls must pass asUserId / asUserEmail,
# and should send X-Org-Id so created rows are stamped with the organization.
EXTERNAL_API_KEYS=colab_REPLACE_WITH_32_RANDOM_URLSAFE_CHARS
# Requests per minute per key (on top of the global API throttle).
EXTERNAL_API_RATE_MAX=300
# Default and maximum `limit` for list endpoints.
EXTERNAL_API_PAGE_SIZE=100
EXTERNAL_API_MAX_PAGE_SIZE=500

# ----- Unified Connector Engine (Teams / Slack / Google / WhatsApp + calendars) -----
# Bridges CoLab conversations with Slack, Microsoft Teams, Google Chat and the
# WhatsApp Cloud API, and mirrors meetings onto Google / Outlook calendars.
# See docs/CONNECTOR_ENGINE.md. On by default; set false to make it dormant
# (management API reports disabled, inbound endpoints 404, worker never runs).
CONNECTORS_ENABLED=true
# Secret the stored platform credentials are sealed under (AES-256-GCM). Falls
# back to AUTH_JWT_SECRET; set a dedicated long random value in production.
CONNECTORS_SECRET=
# Per platform-call timeout and attempts before a job is permanently failed
# (exponential backoff: ~20s, 80s, 5m, 21m, 1h).
CONNECTORS_TIMEOUT_MS=10000
CONNECTORS_MAX_ATTEMPTS=6
# Queue drain cadence, finished-job retention, inbound dedupe window.
CONNECTORS_DRAIN_SECONDS=15
CONNECTORS_JOB_RETENTION_DAYS=14
CONNECTORS_DEDUPE_TTL_SEC=86400
# Inbound budget per connector account per minute, and the per-IP ceiling on
# the public inbound endpoint.
CONNECTORS_INBOUND_PER_MINUTE=300
CONNECTORS_INBOUND_IP_RATE_MAX=600
# Per-conversation cap on channel mappings.
CONNECTORS_MAX_MAPPINGS_PER_CONVERSATION=10
# Calendar delta pull cadence (minutes).
CONNECTORS_CALENDAR_PULL_MINUTES=10
# NEVER in production: skips inbound signature/JWT verification (local fixtures only).
CONNECTORS_INSECURE_SKIP_VERIFY=false
# API versions.
CONNECTORS_MS_GRAPH_VERSION=v1.0
CONNECTORS_WHATSAPP_API_VERSION=v21.0

# ----- Web Push (VAPID) — browser notifications on all devices -----
# Regenerate with: node scripts/generate-vapid-keys.js
# Works across Chrome, Firefox, Edge, Safari 16.4+, Opera, Samsung Internet.
# Without these, notifications only work while a CoLab tab is open.
VAPID_PUBLIC_KEY=BCRpBGqTmJIgxSNURBGnVcHkYuy9mo0RfgrZFzfhHraYpaQQIt8DQbtJDFBzA4nQaaD6rmcpFPm2Tfg0J-DsLiQ
VAPID_PRIVATE_KEY=OdDJyqhR-iTeRwKJ3TN1uFae1LSwd7Kg7UdHUDhvi_Q
VAPID_SUBJECT=mailto:admin@colab.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BCRpBGqTmJIgxSNURBGnVcHkYuy9mo0RfgrZFzfhHraYpaQQIt8DQbtJDFBzA4nQaaD6rmcpFPm2Tfg0J-DsLiQ

# ----- Mobile push (Collab_mobile Flutter app: Android + iOS) -----
# Every web push above is mirrored to the user's registered phones
# (POST /api/push/devices) as an FCM message — same payload, same quiet-hours
# / mute gates. See docs/MOBILE_PUSH.md.
#
# FCM (HTTP v1) — a Firebase SERVICE ACCOUNT key for the project that owns the
# app's google-services.json / GoogleService-Info.plist. Either the JSON
# inline (base64 recommended: `base64 -i service-account.json | tr -d '\n'`)
# or a file path. Unset = mobile push off, everything else unchanged.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# How long FCM holds a message for an offline phone (seconds).
# FCM_MESSAGE_TTL_SEC=86400
# FCM_CALL_TTL_SEC=45
# Attach the recipient's E2EE envelope(s) to an encrypted-message push so the
# phone can decrypt and show the real text from the shade (mobile handoff K7).
# The server has no plaintext for E2EE messages, so with this off they push
# only "Sent a message". Default ON. Plain-text chats always push their preview.
# PUSH_E2EE_CIPHERTEXT=true
# Notification bodies for E2EE messages are plain text: the SENDING client
# attaches a ≤140-char `pushPreview` to an encrypted send and the server uses
# it only as the push body (never stored / echoed). Set false to keep E2EE
# push bodies generic ("Sent a message").
# PUSH_E2EE_PLAINTEXT_PREVIEW=true
#
# APNs VoIP (iOS incoming calls → CallKit even when the app is terminated).
# Token-based auth: an APNs Auth Key (.p8) from the Apple Developer portal
# (Keys → "+" → Apple Push Notifications service). Unset = iOS calls arrive as
# a normal alert instead of a native ring while the app is closed.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
# APNS_KEY_P8=            # .p8 contents (base64 or raw PEM) …
# APNS_KEY_FILE=/run/secrets/AuthKey_ABC123DEFG.p8   # … or a path
# APNS_BUNDLE_ID=com.resulticks.collab
# sandbox for Xcode/dev-profile builds, production for TestFlight/App Store.
# Defaults to production when NODE_ENV=production, sandbox otherwise.
# APNS_ENVIRONMENT=sandbox
