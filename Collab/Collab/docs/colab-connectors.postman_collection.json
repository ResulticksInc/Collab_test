              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Saves data.token to {{colabToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{colabEmail}}\",\n  \"password\": \"{{colabPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {}; if (d.token) pm.environment.set('colabToken', d.token); if (d.refreshToken) pm.environment.set('colabRefresh', d.refreshToken);"
