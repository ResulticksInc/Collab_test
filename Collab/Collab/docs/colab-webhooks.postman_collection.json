    {
      "name": "3 \u00b7 Use the webhook",
      "description": "This is the request your other application actually makes. Note its Auth is set to 'No Auth' \u2014 the token in the URL is the credential, and adding a bearer header here is the single most common mistake.",
      "item": [
        {
          "name": "Post a message into the chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/in/{{ingestToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "in",
                "{{ingestToken}}"
              ]
            },
            "description": "NO Authorization header. Accepts {text}, {title,text}, Slack attachments, or a plain string. Returns the id of the message it created.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ticket #412\",\n  \"text\": \"Rajaram asked you to look at this. https://tracker.example.com/t/412\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('ingestToken')) {",
                  "  console.warn('ingestToken is not set yet \u2014 create an INCOMING webhook first (folder 2).');",
                  "  if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('posted', function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json().data || {};",
                  "console.log('Message', d.messageId, 'posted to', d.conversationId);"
                ]
              }
            }
          ]
        }
      ]
    }
